ENV['WEBENGAGE_USE_CORE'] = 'false'

# Resolve react_native_pods.rb with node to allow for hoisting
def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')
load File.join(__dir__, '../node_modules/@rnmapbox/maps/rnmapbox-maps.podspec')


platform :ios, '15.1'
prepare_react_native_project!

# ⬇️ uncomment the permissions you need
setup_permissions([
 'AppTrackingTransparency',
# 'Bluetooth',
# 'Calendars',
# 'CalendarsWriteOnly',
 'Camera',
# 'Contacts',
# 'FaceID',
'LocationAccuracy',
'LocationAlways',
'LocationWhenInUse',
# 'MediaLibrary',
 'Microphone',
# 'Motion',
# 'Notifications',
 'PhotoLibrary',
# 'PhotoLibraryAddOnly',
# 'Reminders',
# 'Siri',
# 'SpeechRecognition',
# 'StoreKit',
])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'riderx' do
  pod 'WebEngage'
  pod 'WebEngage/Core'
  pod 'WebEngage/Location' 

  use_frameworks! :linkage => :static
  $RNFirebaseAsStaticFramework = true
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
    )

  pre_install do |installer|
    $RNMapboxMaps.pre_install(installer)
  end

  post_install do |installer|
    $RNMapboxMaps.post_install(installer)
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26 / Apple Clang: fmt 11.0.2 FMT_STRING consteval checks fail.
    # The header always redefines FMT_USE_CONSTEVAL, so a -D flag is ignored.
    fmt_base_h = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_h)
      text = File.read(fmt_base_h)
      marker = '// FMT_USE_CONSTEVAL override for Xcode 26 / Clang 17+'
      unless text.include?(marker)
        needle = '#if FMT_USE_CONSTEVAL'
        if text.include?(needle)
          replacement = "#{marker}\n#undef FMT_USE_CONSTEVAL\n#define FMT_USE_CONSTEVAL 0\n#{needle}"
          File.chmod(0644, fmt_base_h)
          File.write(fmt_base_h, text.sub(needle, replacement))
          Pod::UI.puts 'Patched fmt/base.h to disable FMT_USE_CONSTEVAL (Xcode 26)'.green
        else
          Pod::UI.warn 'fmt/base.h structure unexpected; cannot patch FMT_USE_CONSTEVAL'
        end
      end
    end

    %w[debug release].each do |cfg|
      xc = File.join(installer.sandbox.root, 'Target Support Files', 'fmt', "fmt.#{cfg}.xcconfig")
      next unless File.exist?(xc)
      contents = File.read(xc)
      patched = contents.gsub(/CLANG_CXX_LANGUAGE_STANDARD = .*/, 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      File.write(xc, patched) if patched != contents
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'

        # C++17 makes FMT_CPLUSPLUS < 201709L, so fmt skips the broken consteval path.
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end

        if target.name == 'react-native-webengage'
          config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
          config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/WebEngage/WebEngage.xcframework/ios-arm64/WebEngage.framework/Headers"'
          config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PODS_ROOT)/WebEngage/WebEngage.xcframework/ios-arm64_x86_64-simulator/WebEngage.framework/Headers"'
        end
      end
    end
  end
end

target 'NotificationService' do
  use_frameworks! :linkage => :static           
end

